{
  "manifest_version": 3,
  "name": "AniList Episode Ratings",
  "version": "1.6",
  "description": "Названия и оценки серий с IMDb на страницах аниме AniList",
  "background": { "service_worker": "bg.js" },
  "host_permissions": ["https://caching.graphql.imdb.com/*"],
  "content_scripts": [
    {
      "matches": ["https://anilist.co/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
