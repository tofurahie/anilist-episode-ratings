{
  "manifest_version": 3,
  "name": "AniList Ratings",
  "version": "2.0",
  "description": "IMDb per-episode ratings on AniList anime pages, plus average score badges on posters.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage"],
  "host_permissions": ["https://caching.graphql.imdb.com/*"],
  "background": { "service_worker": "bg.js" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "content_scripts": [
    {
      "matches": ["https://anilist.co/*"],
      "js": ["episodes.js", "badges.js"],
      "run_at": "document_idle"
    }
  ]
}
